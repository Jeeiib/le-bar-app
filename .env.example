# Modele de configuration. Copier en .env avant de lancer le projet :
#   cp .env.example .env
# Le fichier .env contient les secrets reels et n'est PAS versionne (voir .gitignore).

# Base de donnees PostgreSQL (l'API et la base partagent ces identifiants)
POSTGRES_DB=barapp
POSTGRES_USER=barapp
POSTGRES_PASSWORD=change-me

# Cle de signature des jetons JWT (longue et aleatoire ; min. 32 caracteres pour HS256)
APP_JWT_SECRET=dev-secret-a-changer-en-production-0123456789-abcdefgh

# Cle DeepL optionnelle pour traduire les imports (repli automatique sur MyMemory si vide)
DEEPL_API_KEY=
